# Required production mode. The runtime refuses any other value.
TM_ENV=production
NODE_ENV=production

# HTTP listener behind an HTTPS reverse proxy / hosting platform.
TM_HOST=0.0.0.0
PORT=3000
PUBLIC_APP_URL=https://taloyhtio.example.com

# Server-only PostgreSQL connection. Never expose this to browser code.
# V2.8a enforces sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Supabase project configuration. No secret/service-role key is required by V2.8a.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Normally derived from SUPABASE_URL. When supplied, it must match exactly.
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_TTL_SECONDS=600

# Anonymous visitor workspace lifetime: 5 minutes to 7 days.
SESSION_TTL_SECONDS=86400
