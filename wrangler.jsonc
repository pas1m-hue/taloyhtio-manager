{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taloyhtio-manager",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b3024d92a27342e6aa77983b47ce0259"
    }
  ],
  "vars": {
    "SUPABASE_JWT_ISSUER": "https://hhbfitngbtchzhvgnevv.supabase.co/auth/v1",
    "SUPABASE_JWT_AUDIENCE": "authenticated",
    "SUPABASE_JWKS_URL": "https://hhbfitngbtchzhvgnevv.supabase.co/auth/v1/.well-known/jwks.json",
    "VISITOR_SESSION_TTL_SECONDS": "86400"
  },
  "observability": { "enabled": true }
}
